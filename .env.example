# Copy to .env.local for local admin testing. Do not commit .env.local.
# These values are names only. Leave secrets out of source control.

ADMIN_SESSION_SECRET=
NOCTARIS_ADMIN_EMAIL=
NOCTARIS_ADMIN_PASSWORD=
NOCTARIS_ADMIN_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# Optional. Public site URL used for canonical links when a real domain is set.
NEXT_PUBLIC_SITE_URL=

# Optional analytics. The measurement ID may be public. The API secret is server-only.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA4_API_SECRET=

# Optional override. Defaults to data/fluffys-admin.sqlite.
ADMIN_DB_PATH=

# Leave unset for local SQLite. Set to firebase only with the local emulators or a reviewed project.
DATA_BACKEND=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_ALLOW_REMOTE=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# Image storage. Leave unset to keep files in public/uploads.
BLOB_READ_WRITE_TOKEN=

# Catering email. Leave unset locally. Use resend or sendgrid only with a real account.
EMAIL_PROVIDER=
EMAIL_MOCK_MODE=
EMAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=
